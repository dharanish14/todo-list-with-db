# Port for the Node/Express server
PORT=5000

# MongoDB Connection String
# For MongoDB Atlas, set your Atlas URI here:
# MONGODB_URI=mongodb+srv://<username>:<password>@your-cluster.mongodb.net/todo_db?retryWrites=true&w=majority
#
# For local Docker setup (default fallback):
MONGODB_URI=mongodb://mongodb:27017/todo_db

# Frontend API URL (for production/Docker proxying)
VITE_API_BASE_URL=http://localhost:5000/api
